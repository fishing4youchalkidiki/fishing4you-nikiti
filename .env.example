NEXT_PUBLIC_SITE_URL=https://fishing4youchalkidiki.com

# Booking form. Set these in Vercel, never in the repo — it is public.
# Without them the form still works: it falls back to WhatsApp.
RESEND_API_KEY=
# Where booking requests land. Dimitris' own address.
BOOKING_TO_EMAIL=fishing4youchalkidiki@gmail.com
# Until a domain is verified, Resend only allows onboarding@resend.dev as the
# sender, and only to the address the account was opened with. That happens to
# be BOOKING_TO_EMAIL, so this works with no DNS at all:
#   BOOKING_FROM_EMAIL=onboarding@resend.dev
# It is Resend's sandbox though. Verifying the domain and switching to the
# address below gets the mail out of a stranger's domain and off the spam
# borderline — worth doing, just not required to go live.
BOOKING_FROM_EMAIL=bookings@fishing4youchalkidiki.com

# Availability calendar. Turso (SQLite) via the Vercel marketplace — the free
# plan's 500M monthly row reads are far beyond anything this site can spend.
# Both are set automatically in Vercel when the database is connected.
#
# Turso is SQLite, so development points this at a plain local file and needs
# no token at all. That is deliberate: it keeps test bookings out of the
# calendar Dimitris actually relies on.
#   TURSO_DATABASE_URL=file:local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# The single password for /admin, where Dimitris records confirmed bookings.
# There are no other accounts, so this is the whole authentication system.
# Changing it here invalidates every session cookie already issued.
ADMIN_PASSWORD=
